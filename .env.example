# ---------------------------------------------------------------------------
# Steuerbot – Konfiguration
# Für den Server erzeugt scripts/deploy.sh diese Datei automatisch (Rechte 600).
# Nie ins Git einchecken!
# ---------------------------------------------------------------------------

# --- Erreichbarkeit / Reverse-Proxy (nur Docker-Betrieb, scripts/deploy.sh fragt das ab) ---
# caddy = mitgelieferter TLS-Proxy | traefik = vorhandener Traefik | port = Host-Port für nginx/Apache/Caddy
# netzwerk = vorhandener Proxy-Container im Docker-Netz (z. B. Nginx Proxy Manager)
STEUERBOT_PROXY=caddy
# nur bei port: STEUERBOT_BIND=127.0.0.1  STEUERBOT_PORT=3000
# nur bei traefik/netzwerk: STEUERBOT_PROXY_NETZWERK=proxy  (traefik: TRAEFIK_ENTRYPOINT=websecure, TRAEFIK_CERTRESOLVER=letsencrypt)
# nur bei caddy und belegten Ports 80/443 (Heimnetz): STEUERBOT_HTTP_PORT=8080  STEUERBOT_HTTPS_PORT=8443
# Domain oder Hostname, unter dem die App erreichbar ist (z. B. steuer.meinefamilie.de oder steuerbot.local)
STEUERBOT_DOMAIN=localhost
# E-Mail für Let's Encrypt (öffentliche Domain) – oder "internal" für eigene Zertifikate im Heimnetz
STEUERBOT_TLS=internal

# --- Anmeldung (Pflicht im Produktivbetrieb) ---
# Einträge mit scripts/benutzer.sh <name> (oder node scripts/passwort-hash.mjs <name>) erzeugen,
# mehrere Benutzer mit Komma trennen: anna=scrypt.…,ben=scrypt.…
STEUERBOT_BENUTZER=
# Zufälliger Schlüssel für Sitzungen, mind. 32 Zeichen: openssl rand -base64 48
STEUERBOT_SESSION_SECRET=
# Sitzungsdauer in Stunden (1–24, Standard 8)
# STEUERBOT_SITZUNG_STUNDEN=8
# Nur für lokale Tests ohne Anmeldung (NIE im Internet): STEUERBOT_AUTH=aus

# --- KI (optional – der Fragebogen funktioniert auch ohne) ---
# Claude-API-Schlüssel von https://platform.claude.com (Settings → API Keys)
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard: claude-opus-5-5)
# STEUERBOT_MODEL=claude-sonnet-5-5

# --- Build (optional) ---
# Image-Tag, wird von deploy.sh/update.sh gesetzt
STEUERBOT_IMAGE_TAG=latest
# Alternative Registry/Spiegel für Basis-Images, z. B. bei Docker-Hub-Limits:
# BUILD_IMAGE=mirror.gcr.io/library/node:22-alpine
# CADDY_IMAGE=mirror.gcr.io/library/caddy:2-alpine
# Firmen-Proxy für den Build:
# HTTPS_PROXY=http://proxy.firma.de:3128
# NPM_CA_FILE=/etc/ssl/certs/firmen-proxy-ca.pem
